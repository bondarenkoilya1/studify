JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Base64 of exactly 32 bytes: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

DATABASE_URL=postgres://studify:studify@localhost:4444/studify?sslmode=disable
SERVER_ADDR=:8080
# Optional private metrics listener. Production defaults to 127.0.0.1:9091.
METRICS_ADDR=

ISSUER=studify
APP_NAME=Studify
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@studify.com
SMTP_USERNAME=
SMTP_PASSWORD=

ENV=dev

# Optional comma-separated CIDRs of reverse proxies trusted to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

# Optional PostgreSQL pool limits (defaults: 20 open and up to 5 idle).
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
