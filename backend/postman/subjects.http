### Get all subjects
GET {{baseUrl}}/subjects/
Accept: application/json

### Get one subject
GET {{baseUrl}}/subjects/{{subjectId}}
Accept: application/json

### Replace one subject
PUT {{baseUrl}}/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Advanced Mathematics",
  "lecturer": "Dr. Elena Petrova",
  "exam_date": "2026-06-25"
}

### Update one subject
PATCH {{baseUrl}}/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "lecturer": "Prof. Elena Petrova"
}

### Delete one subject
DELETE {{baseUrl}}/subjects/{{subjectId}}
Accept: application/json

### Delete all subjects
DELETE {{baseUrl}}/subjects/
Accept: application/json

### Upload lecturer avatar
POST {{baseUrl}}/subjects/avatar/
Content-Type: image/png

< ../avatar.png
