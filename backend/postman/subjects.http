@baseUrl = http://localhost:8080
@subjectId = 1


### Get all subjects
GET {{baseUrl}}/api/subjects/
Accept: application/json


### Get one subject
GET {{baseUrl}}/api/subjects/{{subjectId}}
Accept: application/json


### Create subject
POST {{baseUrl}}/api/subjects/
Content-Type: application/json
Accept: application/json

{
  "name": "Computer Networks",
  "note": "TCP/IP, DNS, routing and network protocols",
  "type": "university",
  "scope": "technology",
  "exam_type": "exam",
  "exam_date": "2026-12-20T09:00:00Z",
  "course": 3,
  "term": 1
}

### Replace one subject
PUT {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Advanced Mathematics",
  "note": "Mathematical analysis and linear algebra",
  "type": "university",
  "scope": "science",
  "exam_type": "exam",
  "exam_date": "2027-01-25T09:00:00Z",
  "course": 3,
  "term": 2
}


### Update one subject
PATCH {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "note": "Updated note"
}


### Upload plain-text course material
POST {{baseUrl}}/api/subjects/{{subjectId}}/file
Content-Type: multipart/form-data; boundary=StudifyExample

--StudifyExample
Content-Disposition: form-data; name="file"; filename="notes.txt"
Content-Type: text/plain

Review the lecture notes before the next class.
--StudifyExample--

### Upload a PNG thumbnail
# Put an avatar.png next to this file or replace the file path below.
POST {{baseUrl}}/api/subjects/{{subjectId}}/thumbnail
Content-Type: image/png

< ./avatar.png

### Delete one subject
DELETE {{baseUrl}}/api/subjects/{{subjectId}}
Accept: application/json


### Delete all subjects
DELETE {{baseUrl}}/api/subjects/
Accept: application/json