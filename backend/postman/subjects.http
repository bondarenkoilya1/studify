@baseUrl = http://localhost:8080
# If BACKEND_HOST_PORT is not 8080, update baseUrl.
@subjectId = 1

### Get all subjects
GET {{baseUrl}}/api/subjects/
Accept: application/json

### Get one subject
GET {{baseUrl}}/api/subjects/{{subjectId}}
Accept: application/json

### Setup: create subject
POST {{baseUrl}}/api/subjects/
Content-Type: application/json
Accept: application/json

  {
    "name": "IT",
    "lecturer": "Dr. Ivan Smith",
    "lecturer_avatar_url": "",
    "exam_date": "2026-05-24T00:00:00Z"
  }

### Replace one subject
PUT {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Advanced Mathematics",
  "lecturer": "Dr. Elena Petrova",
  "exam_date": "2026-06-25T00:00:00Z"
}

### Update one subject
PATCH {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Accept: application/json

{
  "lecturer": "Prof. Elena Petrova"
}

### Delete one subject
DELETE {{baseUrl}}/api/subjects/{{subjectId}}
Accept: application/json

### Delete all subjects
DELETE {{baseUrl}}/api/subjects/
Accept: application/json

### Upload lecturer avatar
POST {{baseUrl}}/api/subjects/avatar/
Content-Type: image/png

< ../avatar.png
