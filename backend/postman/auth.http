@baseUrl = http://localhost:8080
@email = maxonchik@gmail.com
@updatedEmail = maxonchik5@gmail.com
@password = veryverystrong

### Register user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Refresh tokens
POST {{baseUrl}}/api/auth/refresh
Accept: application/json

### Logout user
POST {{baseUrl}}/api/auth/logout
Accept: application/json

### Login updated user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{updatedEmail}}",
  "password": "{{password}}"
}

### Register: invalid body example
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "",
  "password": ""
}

### Get newly generated TOTP code
POST {{baseUrl}}/api/auth/totp
Accept: application/json
