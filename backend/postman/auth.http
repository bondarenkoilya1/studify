@baseUrl = http://localhost:8080
# If BACKEND_HOST_PORT is not 8080, update baseUrl.
@username = maxonchik_ok4
@updatedUsername = maxonchik_ok5
@password = mafak

### Register user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Login user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Refresh tokens
POST {{baseUrl}}/api/auth/refresh
Accept: application/json

### Logout user
POST {{baseUrl}}/api/logout
Accept: application/json

### Login updated user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{updatedUsername}}",
  "password": "{{password}}"
}

### Register: invalid body example
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "",
  "password": ""
}
