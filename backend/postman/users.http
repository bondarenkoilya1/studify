@baseUrl = http://localhost:8080
# If BACKEND_HOST_PORT is not 8080, update baseUrl.

@email = maxonchik@example.com
@updatedEmail = maxonchik_new@example.com
@password = mafak
@updatedPassword = better_password_123

### Get all users
GET {{baseUrl}}/api/users/
Accept: application/json

### Replace user
PUT {{baseUrl}}/api/users/{{email}}
Content-Type: application/json
Accept: application/json

{
  "email": "{{updatedEmail}}",
  "password": "{{updatedPassword}}"
}

### Update user partially
PATCH {{baseUrl}}/api/users/{{updatedEmail}}
Content-Type: application/json
Accept: application/json

{
  "password": "{{password}}"
}

### Delete one user
DELETE {{baseUrl}}/api/users/{{updatedEmail}}
Accept: application/json

### Delete all users
DELETE {{baseUrl}}/api/users/
Accept: application/json