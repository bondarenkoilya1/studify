@baseUrl = http://localhost:8080
# If BACKEND_HOST_PORT is not 8080, update baseUrl.
@taskId = 1

### Get all tasks
GET {{baseUrl}}/api/tasks/
Accept: application/json

### Get one task
GET {{baseUrl}}/api/tasks/{{taskId}}
Accept: application/json

### Setup: create 10 tasks
# Run subjects.http setup first so subject_id values exist.
POST {{baseUrl}}/api/tasks/
Content-Type: application/json
Accept: application/json

[
  {
    "name": "Read chapters 1-3",
    "description": "Mark key definitions for the seminar discussion.",
    "deadline": "2026-06-03T00:00:00Z",
    "status": "completed",
    "subject_id": 1
