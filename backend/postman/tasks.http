@baseUrl = http://localhost:8080
@taskId = 1

### Get all tasks
GET {{baseUrl}}/api/tasks/
Accept: application/json


### Get one task
GET {{baseUrl}}/api/tasks/{{taskId}}
Accept: application/json


### Replace one task
PUT {{baseUrl}}/api/tasks/{{taskId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Review TCP/IP fundamentals",
  "type": "exam",
  "description": "Expanded review of TCP/IP, DNS, routing and network protocols.",
  "estimated_time": 120,
  "scheduled_at": "2026-10-10T18:00:00Z",
  "deadline": "2026-12-15T18:00:00Z",
  "status": "ongoing",
  "difficulty": "high",
  "priority": "high",
  "subject_id": 1
}


### Update one task
PATCH {{baseUrl}}/api/tasks/{{taskId}}
Content-Type: application/json
Accept: application/json

{
  "status": "completed",
  "priority": "low"
}


### Delete one task
DELETE {{baseUrl}}/api/tasks/{{taskId}}
Accept: application/json


### Delete all tasks
DELETE {{baseUrl}}/api/tasks/
Accept: application/json