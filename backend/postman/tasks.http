### Get all tasks
GET {{baseUrl}}/tasks/
Accept: application/json

### Get one task
GET {{baseUrl}}/tasks/{{taskId}}
Accept: application/json

### Replace one task
PUT {{baseUrl}}/tasks/{{taskId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Read chapters 1-4",
  "deadline": "2026-06-04",
  "status": "ongoing",
  "subject_id": 1
}

### Delete one task
DELETE {{baseUrl}}/tasks/{{taskId}}
Accept: application/json

### Delete all tasks
DELETE {{baseUrl}}/tasks/
Accept: application/json
