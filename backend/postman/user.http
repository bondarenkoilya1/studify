@baseUrl = http://localhost:8080
@username = maxonchik_ok4
@updatedUsername = maxonchik_ok5
@password = mafak
@updatedPassword = better_password_123

### Setup: create a user
POST {{baseUrl}}/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Login user
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Get all users
GET {{baseUrl}}/users/
Accept: application/json

### Replace user
PUT {{baseUrl}}/users/{{username}}
Content-Type: application/json
Accept: application/json

{
  "username": "{{updatedUsername}}",
  "password": "{{updatedPassword}}"
}

### Update user partially
PATCH {{baseUrl}}/users/{{updatedUsername}}
Content-Type: application/json
Accept: application/json

{
  "password": "{{password}}"
}

### Login updated user
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{updatedUsername}}",
  "password": "{{password}}"
}

### Delete one user
DELETE {{baseUrl}}/users/{{updatedUsername}}
Accept: application/json

### Register: invalid body example
POST {{baseUrl}}/register
Content-Type: application/json
Accept: application/json

{
  "username": "",
  "password": ""
}

### Delete all users
DELETE {{baseUrl}}/users/
Accept: application/json
